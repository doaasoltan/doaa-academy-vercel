# ===== Doaa Academy — Environment Variables =====
NODE_ENV=production
PORT=3000

# --- Database (TiDB Cloud Starter: free, MySQL-compatible) ---
# From TiDB Cloud > Cluster > Connect, copy the connection string,
# choose the database you created, then append ?sslaccept=strict
# Example: mysql://<user>:<password>@<host>:4000/<database>?sslaccept=strict
# NOTE: URL-encode special characters in the password (e.g. @ -> %40, # -> %23, / -> %2F).
DATABASE_URL=mysql://ACADEMY_DB_USER:ACADEMY_DB_PASSWORD@HOST:4000/doaa_academy?sslaccept=strict

JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
ADMIN_NAME=مديرة الأكاديمية
LOCAL_AUTH=false

# --- File storage (Vercel Blob). Added automatically when you link a Blob store in Vercel ---
BLOB_READ_WRITE_TOKEN=

# --- Optional demo seed (used only by `npm run db:seed`) ---
# SEED_STUDENT_EMAIL=student@demo.test
# SEED_STUDENT_PASSWORD=Demo1234
